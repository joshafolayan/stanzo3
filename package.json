{
  "name": "stanzo3-monorepo",
  "version": "1.0.0",
  "scripts": {
    "start": "npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "build": "cd client && npm install --include=dev && npm run build && cd ../server && npm install"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "private": true,
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
